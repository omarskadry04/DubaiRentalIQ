table MetricSelector
	lineageTag: 748f68f6-b690-4eb8-b3fe-3f0c57e023c2

	column Metric
		dataType: string
		lineageTag: bfad55b0-dead-4f66-af11-2b45ebd4f646
		summarizeBy: none
		sourceColumn: Metric

	partition MetricSelector = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "/model/MetricSelector.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					EmptyToNull = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
					Typed = Table.TransformColumnTypes(EmptyToNull, {{"Metric", type text}}, "en-US")
				in Typed

