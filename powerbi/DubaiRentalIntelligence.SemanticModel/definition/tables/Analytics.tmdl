			RETURN IF([Investigation Queue Visible] = 1, CALCULATE(SELECTEDVALUE(FactListingMonth[room_type]), REMOVEFILTERS(DimMonth), FactListingMonth[month_date] = SnapshotMonth,
			FactListingMonth[active] = TRUE(),
			KEEPFILTERS(FILTER(ALL(FactListingMonth[priority_tier]), FactListingMonth[priority_tier] IN {1,2} && (PriorityChoice = 0 || FactListingMonth[priority_tier] = PriorityChoice))),
			KEEPFILTERS(FILTER(ALL(FactListingMonth[direction]), DirectionChoice = 0 || (DirectionChoice = 1 && FactListingMonth[direction] = "Above Peer Benchmark") || (DirectionChoice = 2 && FactListingMonth[direction] = "Below Peer Benchmark")))))
		displayFolder: Investigations\Queue and Preview
		lineageTag: 984e0ffb-4115-544d-92a0-c0d668b9a9aa

