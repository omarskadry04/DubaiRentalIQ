	measure 'Review Sensitivity Count' = COALESCE((VAR Threshold = SELECTEDVALUE(ReviewThreshold[Threshold], 20) RETURN CALCULATE(COUNTROWS(FactListingMonth), FILTER(FactListingMonth, FactListingMonth[comparison_status] = "Eligible" && ABS(ROUND(FactListingMonth[premium_pct], 9)) >= Threshold))), 0)
		formatString: #,0
