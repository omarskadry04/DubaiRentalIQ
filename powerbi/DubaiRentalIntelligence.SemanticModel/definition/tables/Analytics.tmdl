	measure 'Investigation Queue Context' = VAR N = CALCULATE([Investigation Review Signals], REMOVEFILTERS(DimListing), REMOVEFILTERS(FactListingMonth[listing_id])) RETURN IF(ISBLANK(N), "Validated snapshot unavailable", IF(N = 0, "No matching review cases. Adjust the Market Lens or local filters.", FORMAT(N,"#,0") & " matching cases | Default order: tier, deviation magnitude, ID"))
		displayFolder: Investigations\Queue and Preview
		lineageTag: ad97f3cc-61e4-5fb7-9529-25a89dd78529

	measure 'Investigation Selected ID' = IF(ISFILTERED(FactListingMonth[listing_id]) && COUNTROWS(FILTERS(FactListingMonth[listing_id])) = 1 && [Investigation Queue Visible] = 1, SELECTEDVALUE(FactListingMonth[listing_id]))
		displayFolder: Investigations\Queue and Preview
		lineageTag: 3bab7f16-83aa-57ab-b399-99a193b9faff

	measure 'Investigation Preview State' =
			VAR N = CALCULATE([Investigation Review Signals], REMOVEFILTERS(DimListing), REMOVEFILTERS(FactListingMonth[listing_id]))
			RETURN SWITCH(TRUE(), ISBLANK([Investigation Snapshot Month]), "Validated snapshot unavailable.",
			N = 0, "No matching review cases.", NOT ISFILTERED(FactListingMonth[listing_id]), "Select a listing to preview its evidence.",
			COUNTROWS(FILTERS(FactListingMonth[listing_id])) <> 1, "Select one listing to continue.",
			ISBLANK([Investigation Selected ID]), "Selected listing is outside the current review filters.",
			"Listing " & [Investigation Selected ID])
		displayFolder: Investigations\Queue and Preview
		lineageTag: b9298de9-ce8a-5c74-b84b-87efde1c7482

	measure 'Investigation Preview Profile' = IF(NOT ISBLANK([Investigation Selected ID]), [Investigation Row Area], "")
		displayFolder: Investigations\Queue and Preview
		lineageTag: 7ae01f1e-0231-555b-8d0d-f30868b40a80

	measure 'Investigation Preview Prices' = IF(NOT ISBLANK([Investigation Selected ID]), "Rate AED " & FORMAT([Investigation Row Rate],"#,0.00","en-US") & " | Peer AED " & FORMAT([Investigation Row Median],"#,0.00","en-US"), "")
		displayFolder: Investigations\Queue and Preview
		lineageTag: ff3988df-722a-5a24-8b15-a0ec6052a392

	measure 'Investigation Preview Evidence' = IF(NOT ISBLANK([Investigation Selected ID]), FORMAT([Investigation Row Peers],"#,0") & " peers | " & FORMAT([Investigation Row Radius],"0") & " km | IQR / median " & FORMAT([Investigation Row Dispersion],"0.0%"), "")
		displayFolder: Investigations\Queue and Preview
		lineageTag: 4e557382-eb15-5b45-991d-a02ce191e72e

	measure 'Investigation Preview Limitation' = IF(NOT ISBLANK([Investigation Selected ID]), IF([Investigation Row Tier] = 1, "Meets 2 km / 20+ peers / IQR <=40% criteria.", "Review radius, peer support and dispersion."), "")
		displayFolder: Investigations\Queue and Preview
		lineageTag: 9cba4f48-02ae-5f3c-b84b-aad97f22b581

	measure 'Investigation Preview Attributes' = IF(NOT ISBLANK([Investigation Selected ID]), SWITCH([Investigation Row Accommodation], "entire_home", "Entire home", "private_room", "Private room", "hotel_room", "Hotel room", "shared_room", "Shared room", [Investigation Row Accommodation]) & " | Bedrooms: " & [Investigation Row Bedrooms], "")
		displayFolder: Investigations\Queue and Preview
		lineageTag: e3bdd3a9-52a8-54f1-aa15-c4c076dd0c8c

	measure 'Investigation Preview Deviation' = IF(NOT ISBLANK([Investigation Selected ID]), FORMAT([Investigation Row Deviation],"+0.0%;-0.0%;0.0%") & " | " & IF([Investigation Row Tier] = 1, "Stronger evidence", "Comparability review"), "")
		displayFolder: Investigations\Queue and Preview
		lineageTag: a440ca4e-c2db-5431-b158-2ef1a616b51f

	measure 'Investigation Preview Caution' = IF(NOT ISBLANK([Investigation Selected ID]), "Quality / amenities unverified. Not mispricing proof.", "")
		displayFolder: Investigations\Queue and Preview
		lineageTag: a2bd51df-04e6-5d0d-8693-b903b7d06334

	measure 'Studio Incoming Property' = IF(ISFILTERED(FactListingMonth[listing_id]) && COUNTROWS(FILTERS(FactListingMonth[listing_id])) = 1, MAXX(FILTERS(FactListingMonth[listing_id]), FactListingMonth[listing_id]))
		displayFolder: Integration\Handoff
		lineageTag: 051393bb-f441-585d-a414-9b9d456db065

	measure 'Investigation Studio Destination' = IF(NOT ISBLANK([Investigation Selected ID]), "Competitive Pricing Studio", BLANK())
		displayFolder: Integration\Handoff
		lineageTag: d529dfc3-b64c-5781-b11c-a1a262940bf3

	measure 'Studio Research Mode' = IF(ISFILTERED(FactListingMonth[listing_id]), "INVESTIGATION ACTIVE", "DIRECT LOOKUP READY")
