	measure 'Sensitivity Caption' = "Exploratory threshold: " & FORMAT(SELECTEDVALUE(ReviewThreshold[Threshold], 20), "0") & "% Ã¢â‚¬Â¢ official 20% / 35% classifications remain unchanged"
