	measure 'Latest Priority Order' = IF([Single Property Month] = 1, SELECTEDVALUE(FactListingMonth[review_order]))
		formatString: #,0
		displayFolder: Action queue
		lineageTag: 6883b62e-0bca-413d-bf81-a925966e2584

	measure 'Review Rank In Selection' = IF([Single Property Month] = 1 && NOT ISBLANK(SELECTEDVALUE(FactListingMonth[review_order])), RANKX(FILTER(ALLSELECTED(DimListing[listing_id]), NOT ISBLANK(CALCULATE(MIN(FactListingMonth[review_order])))), CALCULATE(MIN(FactListingMonth[review_order])), , ASC, DENSE))
		formatString: #,0
		displayFolder: Action queue
		lineageTag: 819ce461-07e7-4302-b5bd-538854a5c3bd

	measure 'Selected Action' = IF([Single Property Month] = 1 && MAX(DimMonth[month_date]) = [Latest Data Month], SELECTEDVALUE(FactListingMonth[action], "Inactive / outside latest active queue"), "Priority queue is latest-month only")
		displayFolder: Action queue
		lineageTag: 1d2474ed-68f8-4380-83ca-3e21f18e6c82

	measure 'Action Explanation' = VAR Tier = SELECTEDVALUE(FactListingMonth[priority_tier]) RETURN IF([Single Property Month] <> 1, "Select a queue property to inspect evidence", SWITCH(Tier, 1, "Review deviation: at least 20 peers, 2 km radius, and peer IQR no more than 40% of median. Confirm quality and amenities before action.", 2, "Comparability review first: substantial deviation with wider radius, fewer peers, or greater price dispersion.", 3, "Investigate eligibility, missing metadata, and nearby peer availability. No valid benchmark supports a price comparison.", 4, "Monitor: reported rate is within the official 20% review threshold.", "No latest-month active priority record in this context."))
		displayFolder: Action queue
		lineageTag: 5d5a975d-9597-4674-9150-01d336870119

	measure 'Market Evidence' = FORMAT([Active Listings], "#,0") & " active sampled listings; " & FORMAT([Benchmark Coverage], "0%") & " benchmark coverage. " & FORMAT([Review Candidates], "#,0") & " listing-month review candidates. Provider-estimated occupancy and revenue are not validated business outcomes."
