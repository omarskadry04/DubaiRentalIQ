	measure 'Coverage Investigation Cases' = IF(HASONEVALUE(DimMonth[month_date]) && MAX(DimMonth[month_date]) = [Latest Data Month], COALESCE(CALCULATE(COUNTROWS(FactListingMonth), FactListingMonth[priority_tier] = 3), 0))
		formatString: #,0
