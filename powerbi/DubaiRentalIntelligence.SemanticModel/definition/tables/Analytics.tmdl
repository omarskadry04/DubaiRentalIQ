	measure 'Evidence Summary' = IF([Single Property Month] <> 1, "Select one listing and one month to examine comparison evidence.", IF(ISBLANK([Selected Peer Median]), "No valid benchmark. Investigate eligibility and peer availability before pricing review.", FORMAT([Selected Rate], "AED #,0") & " reported rate vs " & FORMAT([Selected Peer Median], "AED #,0") & " full peer median; " & FORMAT([Selected Premium], "+0.0%;-0.0%") & ". " & FORMAT([Selected Peer Count], "0") & " peers within " & FORMAT([Selected Radius], "0") & " km; IQR / median " & FORMAT([Selected Peer Dispersion], "0%") & ". Unobserved quality and amenities may explain differences."))
