	measure 'Rolling Three Month Median Rate' = VAR EndMonth = MAX(DimMonth[month_date]) RETURN CALCULATE([Median Reported Rate], FILTER(ALL(DimMonth), DimMonth[month_date] <= EndMonth && DimMonth[month_date] >= EDATE(EndMonth, -2)))
