	measure 'Executive Insight' = IF([Active Listing Months] = 0, "No active observations match these filters. Clear a selection to restore the market view.", FORMAT([Review Candidates], "#,0") & " review signals across " & FORMAT([Benchmarked Listing Months], "#,0") & " benchmarked listing-months. " & FORMAT([High Dispersion Benchmarks], "#,0") & " peer groups have IQR above 40% of median. Investigate comparability before considering a rate change.")
