	measure 'Example Availability' = IF([Single Property Month] <> 1, "Select one property and month", IF(MAX(DimMonth[month_date]) <> [Latest Data Month], "Examples available for latest month only", "Up to five nearest examples Ã¢â‚¬Â¢ full benchmark uses all eligible peers"))
