	measure 'Stronger Evidence Candidates' = IF(HASONEVALUE(DimMonth[month_date]) && MAX(DimMonth[month_date]) = [Latest Data Month], COALESCE(CALCULATE(COUNTROWS(FactListingMonth), FactListingMonth[priority_tier] = 1), 0))
