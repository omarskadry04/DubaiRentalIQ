	measure 'Selected Metric Value' = SWITCH(SELECTEDVALUE(MetricSelector[Metric], "Reported rate (AED)"), "Estimated occupancy", [Median Estimated Occupancy], "Estimated revenue (AED)", [Estimated Revenue], [Median Reported Rate])
