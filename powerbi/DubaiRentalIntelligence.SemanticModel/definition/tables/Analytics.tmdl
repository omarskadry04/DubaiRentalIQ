	measure 'Coverage Context' = FORMAT([Observed Listings], "#,0") & " observed properties in selection / " & FORMAT([Global Observed Listing Months], "#,0") & " dataset-wide listing-months. " & FORMAT([Unknown Area Share], "0%") & " of selected records lack a named area."
