	measure 'Prior Month Median Rate' = VAR CurrentMonth = SELECTEDVALUE(DimMonth[month_date]) RETURN IF(NOT ISBLANK(CurrentMonth), CALCULATE([Median Reported Rate], REMOVEFILTERS(DimMonth), DimMonth[month_date] = EDATE(CurrentMonth, -1)))
