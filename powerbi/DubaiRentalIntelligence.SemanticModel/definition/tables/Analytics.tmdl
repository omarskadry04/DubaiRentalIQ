	column placeholder
		dataType: int64
		isHidden
		lineageTag: e447acc5-bc8e-4bce-b90f-e84f5e69d39b
		summarizeBy: none
		sourceColumn: placeholder

	partition Analytics = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "/model/Analytics.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					EmptyToNull = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
					Typed = Table.TransformColumnTypes(EmptyToNull, {{"placeholder", Int64.Type}}, "en-US")
				in Typed

