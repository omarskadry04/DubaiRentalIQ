	measure 'Example Visible' = VAR Subject = SELECTEDVALUE(DimListing[listing_id]) VAR Month = SELECTEDVALUE(DimMonth[month_date]) RETURN IF([Single Property Month] = 1 && Month = [Latest Data Month] && SELECTEDVALUE(PeerExamples[listing_id]) = Subject, 1, 0)
		formatString: 0
		displayFolder: Examples
